# ---------------------------------------------------------------------------
# منصة منهاج قطر التفاعلية — متغيّرات البيئة (اختيارية)
#
# المنصّة تعمل بالكامل بدون هذه المتغيّرات في "وضع العرض" (محتوى مبدئي +
# عدّادات محلية). لتفعيل الرفع الفعلي للأنشطة والعدّادات المشتركة بين الزوّار،
# انسخ هذا الملف إلى .env.local واملأ قيم مشروع Firebase الخاص بك.
# ---------------------------------------------------------------------------

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# اختياري وغير مستخدم: ملفات الألعاب تُخزَّن داخل Firestore لا في Storage
# (Storage صار يتطلّب بطاقة بنكية منذ فبراير 2026).
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# رمز دخول لوحة الإدارة في "وضع العرض" فقط (عند عدم إعداد Firebase).
# عند تفعيل Firebase تُستخدم مصادقة البريد/كلمة المرور الحقيقية بدلًا منه.
NEXT_PUBLIC_ADMIN_PASSCODE=

# (اختياري) معرّف Google Analytics 4 لقياس الزيارات الحقيقي، مثال: G-XXXXXXX
NEXT_PUBLIC_GA_ID=

# (مُهمّ للأرشفة) النطاق الرسمي للموقع — يُستخدم لخريطة الموقع والروابط
# المعيارية (canonical) وبطاقات المشاركة. اضبطه على النطاق الفعلي المنشور
# (أو نطاق الوزارة الرسمي) وإلا أشارت الروابط للنطاق الافتراضي.
NEXT_PUBLIC_SITE_URL=

# (اختياري) رمز التحقّق من ملكية الموقع في Google Search Console.
# انسخ قيمة المحتوى من وسم HTML للتحقّق (google-site-verification) وضعها هنا،
# فيظهر الوسم تلقائيًّا في رأس الصفحة. https://search.google.com/search-console
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# (اختياري) رابط مقطع لغة الإشارة القطرية العام. خيار لغة الإشارة متاح على كل
# نشاط تلقائيًا؛ وعند ضبط هذا الرابط يُعرض على أي نشاط لا يملك مقطعًا خاصًّا به،
# فيبقى الدعم فعّالًا في كل الأنشطة حتى قبل إرفاق مقطع مخصّص لكلٍّ منها.
# يقبل رابط mp4 أو صفحة يوتيوب/فيميو.
NEXT_PUBLIC_SIGN_LANGUAGE_URL=

# --- استيراد الفهرس من صورة (اختياري) -------------------------------------
# UID حساب المالك — يُستخدم على الخادم للتحقّق قبل تحليل الصور.
# متغيّر خادم (بلا NEXT_PUBLIC_) فلا يظهر للزوّار.
ADMIN_UID=

# مفتاح Google Gemini لقراءة صور الفهرس. بدونه يبقى خيار «لصق النص» يعمل.
# احصل عليه من https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
