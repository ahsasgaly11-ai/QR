# ---------------------------------------------------------------------------
# منصة مناهج قطر التفاعلية — متغيّرات البيئة (اختيارية)
#
# المنصّة تعمل بالكامل بدون هذه المتغيّرات في "وضع العرض" (محتوى مبدئي +
# عدّادات محلية). لتفعيل الرفع الفعلي للأنشطة والعدّادات المشتركة بين الزوّار،
# انسخ هذا الملف إلى .env.local واملأ قيم مشروع Firebase الخاص بك.
# ---------------------------------------------------------------------------

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# رمز دخول لوحة الإدارة في "وضع العرض" فقط (عند عدم إعداد Firebase).
# عند تفعيل Firebase تُستخدم مصادقة البريد/كلمة المرور الحقيقية بدلًا منه.
NEXT_PUBLIC_ADMIN_PASSCODE=

# (اختياري) معرّف Google Analytics 4 لقياس الزيارات الحقيقي، مثال: G-XXXXXXX
NEXT_PUBLIC_GA_ID=

# (اختياري) عنوان الموقع النهائي — يُستخدم لخريطة الموقع وبطاقات المشاركة.
NEXT_PUBLIC_SITE_URL=

# --- استيراد الفهرس من صورة (اختياري) -------------------------------------
# UID حساب المالك — يُستخدم على الخادم للتحقّق قبل تحليل الصور.
# متغيّر خادم (بلا NEXT_PUBLIC_) فلا يظهر للزوّار.
ADMIN_UID=

# مفتاح Google Gemini لقراءة صور الفهرس. بدونه يبقى خيار «لصق النص» يعمل.
# احصل عليه من https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
