rules_version = '2';

// ---------------------------------------------------------------------------
// قواعد التخزين — منصة مناهج قطر التفاعلية
//
// ⚠️ هذا الملف غير مستخدم ولا يلزم نشره.
//
// منذ فبراير 2026 صار Cloud Storage for Firebase يتطلّب ربط بطاقة بنكية
// (خطة Blaze) لمجرّد إنشاء مساحة تخزين، حتى مع استخدام صفري. لذا تُخزَّن
// ملفات الألعاب داخل Firestore مقسّمةً إلى أجزاء تحت
// activities/{id}/chunks/** — راجع firestore.rules و src/lib/game-store.ts.
//
// يُحتفظ بهذا الملف لسببين فقط:
//   • إن رُقّي المشروع مستقبلًا إلى Blaze وأُريد استخدام Storage.
//   • إغلاق كل المسارات إغلاقًا تامًّا إن كانت مساحة تخزين موجودة أصلًا.
// ---------------------------------------------------------------------------

service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
