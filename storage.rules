rules_version = '2';

// Firebase Storage rules for the Qatar curriculum platform.
// Uploaded activity files live under /activities/**. They are publicly
// readable (so visitors can play & download), and writable by any signed-in
// session (the admin uploader signs in anonymously before uploading).
//
// Production hardening: restrict writes to admins, e.g.
//   allow write: if request.auth.token.admin == true
//                && request.resource.size < 5 * 1024 * 1024
//                && request.resource.contentType == 'text/html';

service firebase.storage {
  match /b/{bucket}/o {
    match /activities/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024;
    }
  }
}
