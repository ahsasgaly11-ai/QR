rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- المعلمون والبيانات التابعة لهم (قديمة من تطبيق QR — غير مستخدمة) ---
    //  كانت معزولة بـ uid == teacherId، لكنها تتيح لأي حساب مسجَّل كتابة
    //  بيانات غير محدودة تحت وثيقته (استنزاف حصّة Firestore). وبما أنها لم
    //  تعد مستخدمة، أُغلقت تمامًا؛ الوصول الإداري يبقى عبر Console/Admin SDK.
    match /teachers/{teacherId} {
      allow read, write, delete: if false;

      match /classes/{classId} {
        allow read, write, delete: if false;
      }

      match /lessons/{lessonId} {
        allow read, write, delete: if false;
      }

      match /questionBank/{itemId} {
        allow read, write, delete: if false;
      }
    }

    // =====================================================================
    //  مجموعات قديمة من تطبيق الحضور (QR) — لم تعد مستخدمة في المنصّة الحالية.
    //
    //  ⚠️ أمان: كانت هذه المجموعات مفتوحة لأي مستخدم مسجَّل (isSignedIn())
    //  بلا أي عزل بين المعلّمين، فكان بإمكان أي حساب — وإنشاء الحسابات متاح
    //  للجميع عبر مزوّد البريد/كلمة المرور — قراءةَ وحذفَ بيانات كل الطلاب
    //  وأولياء الأمور (بما فيها أرقام واتساب). لذا أُغلقت تمامًا.
    //
    //  الوصول الإداري للبيانات القديمة يبقى متاحًا عبر Firebase Console أو
    //  Admin SDK (يتجاوزان القواعد). وإن أُعيد إحياء تطبيق المعلّمين مستقبلًا
    //  فيجب كتابة قواعد معزولة صراحةً (resource.data.teacherId == request.auth.uid).
    // =====================================================================
    match /students/{studentId} {
      allow read, write, delete: if false;
    }

    match /sessions/{sessionId} {
      allow read, write, delete: if false;
    }

    match /studentResponses/{responseId} {
      allow read, write, delete: if false;
    }

    match /parents/{parentId} {
      allow read, write, delete: if false;
    }

    match /parentLookupsByWhatsapp/{whatsappNumber} {
      allow read, write, delete: if false;
    }

    // =====================================================================
    //  منصة المناهج التفاعلية — Curriculum platform
    //
    //  نموذج الصلاحيات:
    //   • القراءة عامة للجميع (الزوّار يتصفّحون ويشغّلون ويحمّلون).
    //   • الكتابة على المحتوى (الأنشطة/بنية المناهج) للمالك وحده.
    //   • العدّادات يزيدها الزوّار بمقدار 1 فقط، ولا يمكن تعيينها أو محوها.
    // =====================================================================

    // قائمة المالكين: وثيقة واحدة معرّفها = UID حسابك.
    // تُنشأ يدويًا من Firebase Console فقط — لا يمكن إنشاؤها من الموقع،
    // لذا لا يستطيع أي شخص ترقية نفسه إلى مشرف.
    function isOwner() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /admins/{uid} {
      // يقرأ كل مستخدم وثيقته فقط (لتتحقّق الواجهة من صلاحيته)
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false; // لا أحد إطلاقًا — عبر Console حصرًا
    }

    // الأنشطة (الألعاب/التجارب/المحاكاة/الأسئلة)
    match /activities/{activityId} {
      allow read: if true;
      allow write: if isOwner();

      // ملف اللعبة نفسه مقسّمًا إلى أجزاء (بديل Firebase Storage المدفوع).
      // القراءة عامة ليشغّل الزوّار ويحمّلوا، والكتابة للمالك وحده.
      match /chunks/{chunkId} {
        allow read: if true;
        allow write: if isOwner();
      }

      // نسخة معاينة خفيفة تُعرض في بطاقة الدرس بدل تحميل الملف كاملًا
      match /preview/{docId} {
        allow read: if true;
        allow write: if isOwner();
      }
    }

    // بنية المناهج (المواد/المستويات/الوحدات/الدروس)
    match /curriculum/{docId} {
      allow read: if true;
      allow write: if isOwner();
    }

    // --- العدّادات: زيادة فقط، بمقدار 1 كحدّ أقصى لكل عملية ---------------
    function incrementsOnly(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields)
        && request.resource.data.get('visitors', 0) >= resource.data.get('visitors', 0)
        && request.resource.data.get('visitors', 0) <= resource.data.get('visitors', 0) + 1
        && request.resource.data.get('views', 0) >= resource.data.get('views', 0)
        && request.resource.data.get('views', 0) <= resource.data.get('views', 0) + 1
        && request.resource.data.get('downloads', 0) >= resource.data.get('downloads', 0)
        && request.resource.data.get('downloads', 0) <= resource.data.get('downloads', 0) + 1;
    }

    // إحصاءات الموقع (زوّار/مشاهدات/تنزيلات)
    match /stats/{docId} {
      allow read: if true;
      allow create: if request.resource.data.keys()
                      .hasOnly(['visitors', 'views', 'downloads'])
                    && request.resource.data.get('visitors', 0) <= 1
                    && request.resource.data.get('views', 0) <= 1
                    && request.resource.data.get('downloads', 0) <= 1;
      allow update: if isOwner()
                    || incrementsOnly(['visitors', 'views', 'downloads']);
      allow delete: if isOwner();
    }

    // إحصاءات كل نشاط (مشاهدات/تنزيلات)
    match /activityStats/{activityId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['views', 'downloads'])
                    && request.resource.data.get('views', 0) <= 1
                    && request.resource.data.get('downloads', 0) <= 1;
      allow update: if isOwner() || incrementsOnly(['views', 'downloads']);
      allow delete: if isOwner();
    }

    // --- مقاييس كل مدرسة (للخريطة الحرارية) --------------------------------
    //  يختار المستخدم مدرسته قبل اللعب/التحميل، فتُزاد مقاييسها:
    //   users (اختيار المدرسة) · plays (لعب) · downloads (تحميل) · days (توزيع
    //   يومي للمستخدمين). القراءة عامة، والزيادة بمقدار 1 كحدّ أقصى لكل عملية
    //   على العدّادات الرقمية، ولا حذف إلا للمالك.
    function schoolFieldsOk() {
      return request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['users', 'plays', 'downloads', 'days'])
        && request.resource.data.get('users', 0) >= resource.data.get('users', 0)
        && request.resource.data.get('users', 0) <= resource.data.get('users', 0) + 1
        && request.resource.data.get('plays', 0) >= resource.data.get('plays', 0)
        && request.resource.data.get('plays', 0) <= resource.data.get('plays', 0) + 1
        && request.resource.data.get('downloads', 0) >= resource.data.get('downloads', 0)
        && request.resource.data.get('downloads', 0) <= resource.data.get('downloads', 0) + 1;
    }

    match /schoolStats/{schoolId} {
      allow read: if true;
      allow create: if request.resource.data.keys()
                      .hasOnly(['users', 'plays', 'downloads', 'days'])
                    && request.resource.data.get('users', 0) <= 1
                    && request.resource.data.get('plays', 0) <= 1
                    && request.resource.data.get('downloads', 0) <= 1;
      allow update: if isOwner() || schoolFieldsOk();
      allow delete: if isOwner();
    }
  }
}