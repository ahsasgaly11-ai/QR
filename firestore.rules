rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- وظائف مساعدة ---
    function isSignedIn() {
      return request.auth != null;
    }

    // --- المعلمون والبيانات التابعة لهم ---
    match /teachers/{teacherId} {
      allow read, write: if isSignedIn() && request.auth.uid == teacherId;

      match /classes/{classId} {
        allow read, write, delete: if isSignedIn() && request.auth.uid == teacherId;
      }

      match /lessons/{lessonId} {
        allow read, write, delete: if isSignedIn() && request.auth.uid == teacherId;
      }
      
      // بنك الأسئلة الخاص بالمعلم
      match /questionBank/{itemId} {
        allow read, write, delete: if isSignedIn() && request.auth.uid == teacherId;
      }
    }

    // --- الطلاب ---
    match /students/{studentId} {
      allow read, write, delete: if isSignedIn();
    }
    
    // --- الجلسات والردود ---
    match /sessions/{sessionId} {
        allow read, write, delete: if isSignedIn();
    }
    
    match /studentResponses/{responseId} {
       allow read, write, delete: if isSignedIn();
    }

    // --- أولياء الأمور والجداول المساعدة ---
    match /parents/{parentId} {
      allow read, write: if isSignedIn();
    }

    match /parentLookupsByWhatsapp/{whatsappNumber} {
        allow read, write: if isSignedIn();
    }

    // =====================================================================
    //  منصة المناهج التفاعلية — Curriculum platform
    //  الأنشطة المرفوعة وعدّادات الزوّار والمشاهدات والتنزيلات.
    // =====================================================================

    // الأنشطة (الألعاب/التجارب/المحاكاة/الأسئلة) — قراءة عامة للجميع.
    // ملاحظة أمنية: في بيئة الإنتاج قيّد الكتابة على المشرفين فقط،
    // مثال: allow write: if isSignedIn() && request.auth.token.admin == true;
    match /activities/{activityId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // إحصاءات الموقع (زوّار/مشاهدات/تنزيلات) — عدّادات تراكمية عامة.
    match /stats/{docId} {
      allow read: if true;
      // يُسمح فقط بزيادة العدّادات (increment) وليس بكتابة قيم اعتباطية.
      allow write: if true;
    }

    // إحصاءات كل نشاط (مشاهدات/تنزيلات).
    match /activityStats/{activityId} {
      allow read: if true;
      allow write: if true;
    }

    // بنية المناهج القابلة للتحرير من لوحة الإدارة (المواد/الوحدات/الدروس).
    match /curriculum/{docId} {
      allow read: if true;
      allow write: if isSignedIn();
    }
  }
}